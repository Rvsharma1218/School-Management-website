rules_version = '2';

// Multi-School Management System — Firestore Security Rules
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Global User Profiles ──────────────────────────────────────────────────
    // Maps Firebase Auth UID -> User Profile with role and schoolId
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // ── School Root & Subcollections ──────────────────────────────────────────
    // Allows authenticated users to read and write school data
    match /schools/{schoolId} {
      allow read, write: if request.auth != null;

      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // ── School Directory (Public lookup for teacher onboarding & login) ────────
    match /schoolDirectory/{email} {
      allow read, write: if true;

      match /teachersPublic/{teacherUid} {
        allow read, write: if true;
      }
    }

    // ── System Configuration & Subscription Master Control ──────────────────
    match /system_config/{document=**} {
      allow read, write: if true;
    }
  }
}
